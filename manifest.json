{
  "name": "Retro media visualizer",
  "description": "visualizer like windows media player back in the day",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "index.html",
    "default_icon": "images/player.png"
  },
  "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "matches": ["https://open.spotify.com/*"],
      "css": ["css/style.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["images/player.png", "images/media-preview.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
